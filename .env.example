# Sayso environment — copy to .env and everything works offline (`cp .env.example .env`).
# Every var from CONTRACTS.md §3 is documented here with its zero-config default.

# Postgres connection. dev-services (embedded pg) listens on 5433; compose db is 5432 internal.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sayso

# Redis connection for BullMQ. dev-services listens on 6380; compose redis is 6379 internal.
REDIS_URL=redis://localhost:6380

# Auth.js session secret (32+ bytes).
AUTH_SECRET=dev-secret-change-me-32-bytes-minimum!!

# Auth.js base URL.
AUTH_URL=http://localhost:3000

# Optional Google OAuth login. Empty = credentials-only login.
# Also used for the google_ads / ga4 / gsc integration OAuth flows (Phase 2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Ads API developer token — required to connect google_ads in live mode.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Meta (Facebook) app credentials — required to connect Meta ads in live mode.
META_APP_ID=
META_APP_SECRET=

# TikTok Marketing API app credentials — required to connect TikTok ads in live mode.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Bearer secret for the /api/cron/* endpoints (weekly report). Empty = cron disabled.
CRON_SECRET=

# AES-256-GCM key (64 hex chars) for encrypting connected-account tokens.
ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# LLM provider: mock | openai | anthropic. mock = deterministic offline reference impl.
LLM_PROVIDER=mock

# Live LLM keys. Empty with LLM_PROVIDER=mock.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model override. Empty = provider default.
LLM_MODEL=

# Speech-to-text: mock | browser | whisper | deepgram. browser is handled client-side; mock for tests/dev.
STT_PROVIDER=mock

# Deepgram STT key. Empty unless STT_PROVIDER=deepgram.
DEEPGRAM_API_KEY=

# Text-to-speech: mock | browser | openai | elevenlabs.
TTS_PROVIDER=mock

# ElevenLabs key + voice. Empty key unless TTS_PROVIDER=elevenlabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# SEO audit mode: live (falls back to mock on failure) | mock (never hits network).
SEO_AUDIT_MODE=live

# Optional PageSpeed Insights API key.
PAGESPEED_API_KEY=

# Weekly report email (phase 3 stub). Empty = log-only.
RESEND_API_KEY=
EMAIL_FROM=Sayso <reports@sayso.dev>

# Public app URL for absolute links and hosted lead forms.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Client picks browser (Web Speech API) vs mock capture.
NEXT_PUBLIC_STT_PROVIDER=mock

# Client picks speechSynthesis vs server audio.
NEXT_PUBLIC_TTS_PROVIDER=mock

# Seed the demo org on migrate (docker-compose migrate service).
DEMO_SEED=true
