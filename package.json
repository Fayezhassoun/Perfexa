{
  "name": "growthcrew",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"pnpm dev:web\" \"pnpm --filter @growthcrew/worker dev\"",
    "dev:web": "pnpm --filter @growthcrew/web dev",
    "dev:services": "node scripts/dev-services.mjs",
    "db:generate": "pnpm --filter @growthcrew/db db:generate",
    "db:migrate": "pnpm --filter @growthcrew/db db:migrate",
    "db:seed": "pnpm --filter @growthcrew/db db:seed",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @growthcrew/e2e e2e",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "22.20.1",
    "concurrently": "10.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.21.5",
    "redis-memory-server": "0.17.0",
    "tsx": "4.19.4",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
